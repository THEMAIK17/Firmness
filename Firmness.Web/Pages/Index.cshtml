@page
@model IndexModel
@{
    ViewData["Title"] = "Panel";
}

<!-- Welcome Banner -->
<div class="row mb-4 fadeIn">
    <div class="col-12">
        <div class="welcome-banner">
            <div>
                <h2 class="mb-2">Bienvenido al Panel de Administración</h2>
                <p class="mb-0 text-light">Gestiona productos, clientes y ventas desde un solo lugar</p>
            </div>
            <div class="welcome-icon">
                <i class="fas fa-chart-line"></i>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row fadeIn">
    
    <div class="col-md-4 mb-4">
        <div class="card card-gradient card-primary border-0 stat-card">
            <div class="card-body position-relative">
                <i class="fas fa-box-open card-icon"></i>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="stat-icon-circle bg-white bg-opacity-25">
                        <i class="fas fa-box"></i>
                    </div>
                    <span class="badge bg-white bg-opacity-25 text-white">Inventario</span>
                </div>
                <h2 class="stat-number mb-2">@Model.TotalProducts</h2>
                <p class="stat-label mb-0">Productos Totales</p>
                <div class="stat-footer mt-3">
                    <small><i class="fas fa-boxes me-1"></i> Registrados en el sistema</small>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card card-gradient card-success border-0 stat-card">
            <div class="card-body position-relative">
                <i class="fas fa-user-friends card-icon"></i>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="stat-icon-circle bg-white bg-opacity-25">
                        <i class="fas fa-users"></i>
                    </div>
                    <span class="badge bg-white bg-opacity-25 text-white">Usuarios</span>
                </div>
                <h2 class="stat-number mb-2">@Model.TotalClients</h2>
                <p class="stat-label mb-0">Clientes Activos</p>
                <div class="stat-footer mt-3">
                    <small><i class="fas fa-user-check me-1"></i> Usuarios registrados</small>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-4">
        <div class="card card-gradient card-info border-0 stat-card">
            <div class="card-body position-relative">
                <i class="fas fa-chart-line card-icon"></i>
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="stat-icon-circle bg-white bg-opacity-25">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <span class="badge bg-white bg-opacity-25 text-white">Transacciones</span>
                </div>
                <h2 class="stat-number mb-2">@Model.TotalSales</h2>
                <p class="stat-label mb-0">Ventas Completadas</p>
                <div class="stat-footer mt-3">
                    <small><i class="fas fa-check-circle me-1"></i> Procesadas exitosamente</small>
                </div>
            </div>
        </div>
    </div>
    
</div>