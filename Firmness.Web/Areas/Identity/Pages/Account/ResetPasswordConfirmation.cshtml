@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Contraseña Actualizada";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firmeza Admin</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <style>
        :root {
            --gradient-primary: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            --gradient-success: linear-gradient(135deg, #059669 0%, #10b981 100%);
            --color-dark: #0f172a;
            --shadow-xl: 0 20px 25px rgba(0, 0, 0, 0.15);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        
        .confirmation-container {
            width: 100%;
            max-width: 500px;
        }
        
        .confirmation-card {
            background: white;
            border-radius: 1.5rem;
            box-shadow: var(--shadow-xl);
            overflow: hidden;
            animation: fadeInUp 0.5s ease;
        }
        
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .confirmation-header {
            background: var(--gradient-success);
            color: white;
            padding: 2.5rem 2rem;
            text-align: center;
        }
        
        .confirmation-header i {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            opacity: 0.95;
            animation: successPulse 2s ease-in-out infinite;
        }
        
        @@keyframes successPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }
        
        .confirmation-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }
        
        .confirmation-header p {
            color: rgba(255,255,255,0.95);
            font-size: 0.95rem;
        }
        
        .confirmation-body {
            padding: 2.5rem 2rem;
            text-align: center;
        }
        
        .confirmation-body p {
            color: #475569;
            font-size: 1.05rem;
            line-height: 1.6;
            margin-bottom: 2rem;
        }
        
        .success-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 0.75rem;
            padding: 1.25rem;
            margin-bottom: 2rem;
        }
        
        .success-box i {
            color: #16a34a;
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
        }
        
        .success-box p {
            color: #14532d;
            font-size: 0.9rem;
            margin: 0;
        }
        
        .btn-login {
            background: var(--gradient-primary);
            border: none;
            padding: 0.875rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 0.75rem;
            transition: all 0.3s ease;
            color: white;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(30, 60, 114, 0.3);
            color: white;
        }
    </style>
</head>
<body>
    <div class="confirmation-container">
        <div class="confirmation-card">
            <div class="confirmation-header">
                <i class="fas fa-circle-check"></i>
                <h1>¡Contraseña Actualizada!</h1>
                <p>Tu contraseña ha sido restablecida con éxito</p>
            </div>
            
            <div class="confirmation-body">
                <p>
                    Tu contraseña se ha actualizado correctamente. Ahora puedes iniciar sesión con tu nueva contraseña.
                </p>
                
                <div class="success-box">
                    <i class="fas fa-shield-check"></i>
                    <p>
                        <strong>Seguridad:</strong> Tu cuenta está protegida. 
                        Recuerda mantener tu contraseña segura y no compartirla con nadie.
                    </p>
                </div>
                
                <a asp-page="./Login" class="btn-login">
                    <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                </a>
            </div>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
